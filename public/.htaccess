# Online Task Lab - Apache URL Rewrite Rules for React Single Page App (SPA)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Exclude /api routes from SPA rewrite to avoid returning index.html for API requests
  RewriteCond %{REQUEST_URI} ^/api(/.*)?$ [NC]
  RewriteRule ^ - [L]

  # If the requested file or directory exists, serve it directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Otherwise, redirect all non-API requests to index.html so React Router handles SPA routing
  RewriteRule ^ index.html [L]
</IfModule>

# Optional: Reverse proxy /api to Node.js backend if mod_proxy is enabled in Apache/cPanel
<IfModule mod_proxy.c>
  <IfModule mod_proxy_http.c>
    RewriteEngine On
    RewriteCond %{REQUEST_URI} ^/api/(.*)$ [NC]
    RewriteRule ^api/(.*)$ http://127.0.0.1:3000/api/$1 [P,L]
  </IfModule>
</IfModule>

