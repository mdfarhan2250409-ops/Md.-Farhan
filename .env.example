# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional Production Frontend API Base URL (leave empty if frontend and backend are served from the same domain)
# Example: https://api.yourdomain.com
VITE_API_URL=

# Brevo SMTP / API Transactional Email Configuration (Server-Side)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
SMTP_FROM_NAME="Online Task Lab"
SMTP_FROM_EMAIL=
BREVO_API_KEY=

# Optional Alternative AI Providers (Groq, OpenAI-compatible)
GROQ_API_KEY=
OPENAI_API_KEY=

# ElevenLabs Text-to-Speech (TTS) API Configuration (Server-Side)
ELEVENLABS_API_KEY=
